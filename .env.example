# --- Manager ---
# Path to the jobs file (default: ./jobs.toml)
JOBS_FILE="./jobs.toml"
# Directory for generated files and the run history database (default: ./data)
DATA_DIR="./data"
# Status server address; set to an empty string to disable it (default: 127.0.0.1:8787)
HTTP_ADDR="127.0.0.1:8787"
# Days of run history to keep (default: 30)
HISTORY_RETENTION_DAYS="30"
# Log level (default: info)
RUST_LOG="info"

# --- Last.fm builtins (optional) ---
# Leave LAST_FM_USERNAME unset to run vps-cron without any Last.fm jobs.
LAST_FM_API_KEY="12345"
LAST_FM_USERNAME="your_username"
# Where the Last.fm JSON exports are written (default: DATA_DIR)
DESTINATION_FOLDER="./data"
# Scrobble history database (default: DATA_DIR/scrobbles.db)
LAST_FM_DB_FILE="./data/scrobbles.db"

# --- GitHub gist builtin (optional) ---
GITHUB_TOKEN="ghp_xxx"
GIST_ID="your_gist_id"
GIST_FILENAME="top-tracks.md"
